# Порт сервера
PORT=3000

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=egypt_estate
DB_USER=egypt_user
DB_PASSWORD=change-me

# Секрет для JWT (ОБЯЗАТЕЛЬНО задайте свой — сервер не запустится без него).
# Значение ниже — только пример формата, НЕ используйте его в реальности.
# Сгенерируйте новый: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-replace-me-with-output-of-crypto-randomBytes-48-hex-string-00000000

# Разрешённый origin для CORS
CORS_ORIGIN=http://localhost:3000

# --- Учётная запись администратора ---
# Логин задан в schema.sql ('admin'). Пароль хранится ТОЛЬКО как bcrypt-хеш.
# Текущий временный пароль выдан при генерации; чтобы сменить его:
#   node -e "console.log(require('bcryptjs').hashSync('НОВЫЙ_ПАРОЛЬ',10))"
# и обновите password_hash в users (БД + schema.sql).
ADMIN_USERNAME=admin
