# Порт сервера
PORT=3000

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=egypt_estate
DB_USER=egypt_user
DB_PASSWORD=change-me

# Секрет для JWT (обязательно замените!)
JWT_SECRET=1b97989ceb32ca37c6ae08aef42f414abb041337d1d452d33d8908af7af9179b

# Разрешённый origin для CORS
CORS_ORIGIN=*

# --- Учётная запись администратора ---
# Логин задан в schema.sql ('admin'). Пароль хранится ТОЛЬКО как bcrypt-хеш.
# Текущий временный пароль выдан при генерации; чтобы сменить его:
#   node -e "console.log(require('bcryptjs').hashSync('НОВЫЙ_ПАРОЛЬ',10))"
# и обновите password_hash в users (БД + schema.sql).
ADMIN_USERNAME=admin
